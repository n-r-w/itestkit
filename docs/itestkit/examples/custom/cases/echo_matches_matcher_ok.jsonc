{
  "name": "echo compares message by regex",
  "description": "demonstrates $matches for a selected string field",
  "steps": [
    {
      "id": "prepare-prefix",
      "kind": "prepare",
      "handler": "SetPrefix",
      "request": {
        "prefix": "trace-"
      }
    },
    {
      "id": "action-echo",
      "kind": "action",
      "handler": "Echo",
      "request": {
        "message": "12345"
      }
    }
  ],
  "assert": {
    "code": "OK",
    "response_from_step": "action-echo",
    "response": {
      // The regex controls accepted dynamic string shape while exact mode still checks listed fields.
      "message": { "$matches": "^trace-\\d+$" }
    }
  }
}
