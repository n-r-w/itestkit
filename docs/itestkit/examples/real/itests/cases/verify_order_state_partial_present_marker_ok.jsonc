// Present marker in partial mode: the scenario checks selected persisted fields
// and allows the response to contain other fields.
{
  "name": "verify order state partial response with present markers",
  "steps": [
    // Step 1 (prepare): seed order in in-memory DB.
    {
      "id": "seed-orders",
      "kind": "prepare",
      "handler": "SeedOrders",
      "request": {
        "orders": [
          {
            "order_id": "order-present-partial-real",
            "amount": 6100
          }
        ]
      }
    },
    // Step 2 (prepare): plan expected outbound calls and external API responses.
    {
      "id": "plan-external",
      "kind": "prepare",
      "handler": "PlanExternalCalls",
      "request": {
        "calls": [
          {
            "expected_service": "risk:order-present-partial-real",
            "stub_response": {
              "status": "SERVING"
            }
          },
          {
            "expected_service": "reserve:order-present-partial-real",
            "stub_response": {
              "status": "NOT_SERVING"
            }
          },
          {
            "expected_service": "manual:order-present-partial-real",
            "stub_response": {
              "status": "SERVICE_UNKNOWN"
            }
          }
        ]
      }
    },
    // Step 3 (action): call our service API so it updates order state.
    {
      "id": "call-api",
      "kind": "action",
      "handler": "CallOrderAPI",
      "request": {
        "order_id": "{{steps.seed-orders.response.orders.0.order_id}}"
      }
    },
    // Step 4 (verify): read persisted state for final assertion.
    {
      "id": "verify-order-state",
      "kind": "verify",
      "handler": "VerifyOrderState",
      "request": {
        "order_id": "{{steps.seed-orders.response.orders.0.order_id}}",
        "expected_status": "SERVICE_UNKNOWN",
        "expected_external_services": [
          "{{steps.plan-external.response.calls.0.expected_service}}",
          "{{steps.plan-external.response.calls.1.expected_service}}",
          "{{steps.plan-external.response.calls.2.expected_service}}"
        ]
      }
    }
  ],
  "assert": {
    "code": "OK",
    "response_from_step": "verify-order-state",
    "response_mode": "partial",
    "response": {
      "order_id": "order-present-partial-real",
      // The numeric amount field must exist with any value.
      "amount": { "$present": true },
      "status": "SERVICE_UNKNOWN",
      // Partial mode checks this selected field and ignores fields not listed here.
      "external_services": { "$present": true }
    }
  }
}
