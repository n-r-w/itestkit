{
    // Calendar macros keep this case relative to the shared fixed test date.
    "name": "booking quote uses calendar macros",
    "steps": [
        {
            "id": "seed-data",
            "kind": "prepare",
            "handler": "SeedData",
            "request": {
                "bookings": [
                    {
                        "booking_id": "booking-100",
                        "hotel_id": "hotel-7",
                        "check_in_date": "<test_date+10d>",
                        "check_out_date": "<test_date+12d>"
                    }
                ]
            }
        },
        {
            "id": "plan-external",
            "kind": "prepare",
            "handler": "PlanExternalQuote",
            "request": {
                "expected_request": {
                    "hotel_id": "hotel-7",
                    "check_in_date": "<test_date+10d>",
                    "check_out_date": "<test_date+12d>",
                    "requested_at": "<test_timestamp>"
                },
                "stub_response": {
                    "rate_id": "rate-501",
                    "expires_at": "<test_rfc3339_timestamp+2h30m>"
                }
            }
        },
        {
            "id": "create-quote",
            "kind": "action",
            "handler": "CreateBookingQuote",
            "request": {
                "booking_id": "booking-100"
            }
        },
        {
            "id": "verify-external",
            "kind": "verify",
            "handler": "VerifyExternalQuote",
            "request": {
                "booking_id": "booking-100"
            }
        }
    ],
    "assert": {
        "code": "OK",
        "response_from_step": "create-quote",
        "response": {
            "booking_id": "booking-100",
            "hotel_id": "hotel-7",
            "check_in_date": "2026-03-11",
            "check_out_date": "2026-03-13",
            "nights": 2,
            "days_until_check_in": 10,
            "rate_id": "rate-501",
            // $same_instant compares the macro-rendered instant without requiring identical timezone text.
            "quote_expires_at": { "$same_instant": "<test_rfc3339_timestamp+2h30m@+03:00>" }
        }
    }
}
